{
  "name": "scripture-bridge-web",
  "version": "0.1.0",
  "private": true,
  "description": "Operations console for the Scripture Bridge Supabase backend.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check-stack": "node scripts/check-stack.mjs",
    "check-bundle": "node scripts/check-bundle.mjs",
    "check-schema": "node scripts/check-schema.mjs",
    "verify-e2e": "node scripts/verify-e2e.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check-bundle && npm run check-schema",
    "test": "node --test scripts/test-usfm.mjs scripts/test-pg-ssl.mjs",
    "reset-operator": "node scripts/reset-operator.mjs"
  },
  "dependencies": {
    "next": "^15.1.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
