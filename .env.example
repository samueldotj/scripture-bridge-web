# Scripture Bridge console — configuration
#
# Copy to .env.local and fill in. Every value here is a secret or points at one;
# .env.local is gitignored and must stay that way.
#
# There is deliberately no NEXT_PUBLIC_* variable in this project. The browser
# never talks to Supabase — it talks to this server, which holds the keys.

# Postgres connection. The console's read and RPC path.
# Local stack:  postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted:       use the connection string from the Supabase dashboard, with
#               ?sslmode=require, and prefer the pooler for a long-lived app.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase API origin. Local stack: http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321

# Service key. Used ONLY for the GoTrue admin API (account creation, password
# reset). It bypasses RLS entirely — its exposure is a full compromise of every
# project's data, which is why the console exists as a server-side component at
# all (DB R-RLS-3).
SUPABASE_SERVICE_ROLE_KEY=

# Anon key. Used ONLY to verify an operator's own password at sign-in.
SUPABASE_ANON_KEY=

# Who may use this console, comma-separated. Each must also be a real auth user:
# the console verifies their password against GoTrue and does not hold a second
# credential store. Re-checked on every request, so removing someone here takes
# effect on their next click rather than when their cookie expires.
CONSOLE_OPERATORS=coordinator@example.org

# Signing key for the console's session cookie. At least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONSOLE_SESSION_SECRET=

# Session lifetime in hours. Default 8 — one working day.
CONSOLE_SESSION_HOURS=8
